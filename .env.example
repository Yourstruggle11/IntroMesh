# ─────────────────────────────────────────────────────────────
# IntroMesh environment. Copy to .env.local and fill in.
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
# Public contact address shown in the footer and policy pages
SUPPORT_EMAIL=
# Comma-separated emails that get the /admin page
ADMIN_EMAILS=
# Random string; protects /api/cron/tick
CRON_SECRET=

# Database: Supabase Postgres.
# Use the "Transaction pooler" URI (port 6543) for the app.
# Leave empty for local dev to use the embedded PGlite database (./.pglite).
DATABASE_URL=
# Optional: "Direct connection" URI (port 5432), used by `npm run db:migrate`.
DATABASE_URL_DIRECT=

# AI: Google Gemini (https://aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Email via SMTP. Gmail example: smtp.gmail.com / 465 / you@gmail.com / 16-char app password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="IntroMesh <you@gmail.com>"

# TigerGraph Savanna
TG_HOST=
TG_GRAPH=IntroMesh
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=

# Crypto payments (USDC). Chains: base, polygon, arbitrum
# testnet = Base Sepolia / Polygon Amoy / Arbitrum Sepolia with free faucet USDC (no real money)
# mainnet = real USDC (Cake Wallet works here). Payouts never cross networks.
CRYPTO_NETWORK=testnet
CRYPTO_CHAINS=base,polygon,arbitrum
CRYPTO_DEFAULT_CHAIN=base
# Server wallet: receives payments and pays out bounties. Generate with `npm run wallet:new`.
WALLET_PRIVATE_KEY=
# Optional custom RPC endpoints (public defaults are used if empty)
RPC_BASE=
RPC_POLYGON=
RPC_ARBITRUM=

# Dodo Payments (test mode)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENV=test_mode
DODO_PRODUCT_PRO=
DODO_PRODUCT_TEAM=
